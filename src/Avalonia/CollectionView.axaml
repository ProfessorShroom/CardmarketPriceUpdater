<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Cardmarket_Price_Updater"
             x:Class="Cardmarket_Price_Updater.CollectionView">

  <UserControl.Styles>

    <Style Selector="ToggleButton.chip">
      <Setter Property="Background" Value="#2D2D2D" />
      <Setter Property="Foreground" Value="#8A8A8A" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="12,5" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="ToggleButton.chip:checked /template/ ContentPresenter">
      <Setter Property="Background" Value="#4A4A4A" />
    </Style>
    <Style Selector="ToggleButton.chip:checked">
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="ToggleButton.chip:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#555555" />
    </Style>
    <Style Selector="ToggleButton.chip:not(:checked) Ellipse">
      <Setter Property="Opacity" Value="0.35" />
    </Style>

    <Style Selector="TextBox /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="#2D2D2D" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="#333333" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="#2D2D2D" />
      <Setter Property="BorderBrush" Value="#5A5A5A" />
    </Style>

    <Style Selector="Border.tile">
      <Setter Property="Background" Value="#282828" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Margin" Value="0,0,12,12" />
      <Setter Property="Width" Value="190" />
      <Setter Property="ClipToBounds" Value="True" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Border.tile.selected">
      <Setter Property="BorderBrush" Value="#D0D0D0" />
    </Style>
    <Style Selector="Border.tile:pointerover">
      <Setter Property="Background" Value="#303030" />
    </Style>

    <Style Selector="Button.save">
      <Setter Property="Background" Value="#2E7D32" />
    </Style>
    <Style Selector="Button.save:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#388E3C" />
    </Style>

    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="#9A9A9A" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="Foreground" Value="#9A9A9A" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TextBlock.stat">
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
  </UserControl.Styles>

  <DockPanel>
    <Border DockPanel.Dock="Top" Background="#282828" Padding="12,10">
      <Grid ColumnDefinitions="*,Auto">
        <WrapPanel Grid.Column="0" Orientation="Horizontal">
          <Button x:Name="OpenButton" Classes="flat" Content="Open Spreadsheet"
                  Margin="0,0,8,4" VerticalAlignment="Center" />
          <Button x:Name="ReloadButton" Classes="flat" Content="Reload" IsEnabled="False"
                  Margin="0,0,12,4" VerticalAlignment="Center"
                  ToolTip.Tip="Read the spreadsheet again, e.g. after updating prices" />

          <TextBox x:Name="SearchBox" Width="220" PlaceholderText="Search name, set, rarity..."
                   Foreground="White" Margin="0,0,8,4" VerticalAlignment="Center" />

          <ComboBox x:Name="GameFilter" Width="190" Margin="0,0,8,4" VerticalAlignment="Center" />

          <ComboBox x:Name="SortCombo" Width="190" Margin="0,0,8,4" VerticalAlignment="Center" />
        </WrapPanel>

        <TextBlock x:Name="FileText" Grid.Column="1" Classes="muted" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" MaxWidth="360" Margin="10,0,0,4" />
      </Grid>
    </Border>

    <Border DockPanel.Dock="Top" Padding="12,10,12,4">
      <WrapPanel Orientation="Horizontal">
        <TextBlock Text="Show:" Classes="label" VerticalAlignment="Center" Margin="0,0,10,4" />

        <ToggleButton x:Name="ShowOwned" Classes="chip" IsChecked="True" Margin="0,0,8,4"
                      ToolTip.Tip="Cards you own in the edition/grade you want (✔, 1st Edition, PSA9, PSA10...)">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <Ellipse Width="9" Height="9" Fill="#00B050" VerticalAlignment="Center" />
            <TextBlock x:Name="OwnedChipText" Text="Owned" VerticalAlignment="Center" />
          </StackPanel>
        </ToggleButton>

        <ToggleButton x:Name="ShowUpgrade" Classes="chip" IsChecked="True" Margin="0,0,8,4"
                      ToolTip.Tip="Cards you own but want a better copy of (Unlimited, PSA1-PSA8)">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <Ellipse Width="9" Height="9" Fill="#0070C0" VerticalAlignment="Center" />
            <TextBlock x:Name="UpgradeChipText" Text="Needs upgrade" VerticalAlignment="Center" />
          </StackPanel>
        </ToggleButton>

        <ToggleButton x:Name="ShowNotOwned" Classes="chip" IsChecked="True" Margin="0,0,16,4"
                      ToolTip.Tip="Cards you haven't bought yet (✖)">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <Ellipse Width="9" Height="9" Fill="#C00000" VerticalAlignment="Center" />
            <TextBlock x:Name="NotOwnedChipText" Text="Not owned" VerticalAlignment="Center" />
          </StackPanel>
        </ToggleButton>

        <Button x:Name="OnlyUpgradeButton" Classes="flat" Content="Only upgrades" Margin="0,0,6,4"
                Padding="10,5" FontSize="12" />
        <Button x:Name="OnlyNotOwnedButton" Classes="flat" Content="Only not owned" Margin="0,0,6,4"
                Padding="10,5" FontSize="12" />
        <Button x:Name="ShowAllButton" Classes="flat" Content="Show all" Margin="0,0,6,4"
                Padding="10,5" FontSize="12" />
      </WrapPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" Background="#282828" Padding="12,8">
      <WrapPanel Orientation="Horizontal">
        <StackPanel Margin="0,0,28,0">
          <TextBlock Text="Showing" Classes="label" />
          <TextBlock x:Name="ShowingText" Text="-" Classes="stat" />
        </StackPanel>
        <StackPanel Margin="0,0,28,0">
          <TextBlock Text="Value of shown cards" Classes="label" />
          <TextBlock x:Name="ShownValueText" Text="-" Classes="stat" />
        </StackPanel>
        <StackPanel Margin="0,0,28,0">
          <TextBlock Text="Collection value (owned)" Classes="label" />
          <TextBlock x:Name="OwnedValueText" Text="-" Classes="stat" />
        </StackPanel>
        <StackPanel Margin="0,0,28,0">
          <TextBlock Text="Amount spent" Classes="label" />
          <TextBlock x:Name="SpentText" Text="-" Classes="stat" />
        </StackPanel>
        <StackPanel x:Name="PulledStat" Margin="0,0,28,0" IsVisible="False">
          <TextBlock Text="Pulled" Classes="label" />
          <TextBlock x:Name="PulledText" Text="-" Classes="stat" />
        </StackPanel>
        <StackPanel Margin="0,0,28,0">
          <TextBlock Text="Cost to complete" Classes="label" />
          <TextBlock x:Name="ToCompleteText" Text="-" Classes="stat" />
        </StackPanel>
        <StackPanel Margin="0,0,28,0">
          <TextBlock Text="Owned" Classes="label" />
          <TextBlock x:Name="PercentText" Text="-" Classes="stat" />
        </StackPanel>
      </WrapPanel>
    </Border>

    <Grid ColumnDefinitions="*,Auto">
      <ScrollViewer x:Name="CardScroller" Grid.Column="0" Padding="12,8,0,0"
                    HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <ItemsControl x:Name="CardList">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>

          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="local:CardTile">
              <Border Classes="tile" Classes.selected="{Binding IsSelected}" ToolTip.Tip="{Binding Tooltip}">
                <DockPanel>
                  <Border DockPanel.Dock="Top" Height="4" Background="{Binding StatusBrush}" />

                  <StackPanel Margin="10,10,10,12" Spacing="2">
                    <Border Height="210" Background="#202020" CornerRadius="4" Margin="0,0,0,8">
                      <Panel>
                        <Image Source="{Binding Image}" Stretch="Uniform" Margin="6"
                               IsVisible="{Binding HasImage}" />
                        <TextBlock Text="No image" Classes="muted" IsVisible="{Binding !HasImage}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Panel>
                    </Border>

                    <TextBlock Text="{Binding Title}" Foreground="White" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Subtitle}" Classes="muted" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Meta}" Classes="muted" TextTrimming="CharacterEllipsis" />

                    <TextBlock Text="{Binding PriceText}" Foreground="White" Margin="0,6,0,2"
                               FontSize="18" FontWeight="Bold" TextTrimming="CharacterEllipsis" />

                    <Border Background="{Binding StatusBrush}" CornerRadius="10" Padding="8,2"
                            BorderBrush="{Binding BadgeBorder}" BorderThickness="1"
                            HorizontalAlignment="Left">
                      <TextBlock Text="{Binding EditionText}" Foreground="{Binding BadgeForeground}" FontSize="12"
                                 FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    </Border>

                    <TextBlock Text="{Binding BoughtText}" Classes="muted" Margin="0,4,0,0"
                               IsVisible="{Binding HasBought}" />
                  </StackPanel>
                </DockPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <TextBlock x:Name="EmptyText" Grid.Column="0" Classes="muted" FontSize="14"
                 HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                 Text="Open a spreadsheet to view your collection,&#10;or update prices and it will show here." />

      <Border x:Name="EditorPanel" Grid.Column="1" Width="300" Background="#252525" IsVisible="False"
              BorderBrush="#333333" BorderThickness="1,0,0,0">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="16,14,16,16" Spacing="4">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="Edit card" Classes="label" VerticalAlignment="Center" />
              <Button x:Name="EditorCloseButton" Grid.Column="1" Classes="flat" Content="✕"
                      Padding="8,2" ToolTip.Tip="Close (Esc)" />
            </Grid>

            <Border Height="250" Background="#1E1E1E" CornerRadius="4" Margin="0,6,0,6">
              <Panel>
                <Image x:Name="EditorImage" Stretch="Uniform" Margin="8" />
                <TextBlock x:Name="EditorNoImage" Text="No image" Classes="muted"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Panel>
            </Border>
            <Button x:Name="ImageButton" Classes="flat" Content="Add image..." Margin="0,0,0,10"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    ToolTip.Tip="Choose a picture of the card (JPG, PNG, WebP...) to put in the spreadsheet's Image column" />

            <TextBlock x:Name="EditorTitle" Foreground="White" FontWeight="SemiBold" FontSize="15"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="EditorSubtitle" Classes="muted" TextWrapping="Wrap" />
            <TextBlock x:Name="EditorMeta" Classes="muted" TextWrapping="Wrap" />
            <TextBlock x:Name="EditorPrice" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,4,0,8" />

            <TextBlock Text="Edition" Classes="label" />
            <ComboBox x:Name="EditionCombo" HorizontalAlignment="Stretch" Margin="0,0,0,4" />
            <WrapPanel Orientation="Horizontal" Margin="0,0,0,8">
              <Button x:Name="QuickTick" Classes="flat" Content="✔" Margin="0,0,6,6" Padding="10,4"
                      ToolTip.Tip="Owned" />
              <Button x:Name="QuickFirst" Classes="flat" Content="1st Edition" Margin="0,0,6,6" Padding="10,4" />
              <Button x:Name="QuickLimited" Classes="flat" Content="Limited" Margin="0,0,6,6" Padding="10,4"
                      ToolTip.Tip="LIMITED EDITION" />
              <Button x:Name="QuickUnlimited" Classes="flat" Content="Unlimited" Margin="0,0,6,6" Padding="10,4" />
              <Button x:Name="QuickCross" Classes="flat" Content="✖" Margin="0,0,6,6" Padding="10,4"
                      ToolTip.Tip="Not owned" />
            </WrapPanel>

            <TextBlock x:Name="BoughtLabel" Text="Bought for" Classes="label" />
            <TextBox x:Name="BoughtBox" Foreground="White" PlaceholderText="e.g. 50.00" Margin="0,0,0,4" />
            <CheckBox x:Name="PulledCheck" Content="Pulled it myself" Foreground="White" Margin="0,0,0,12"
                      ToolTip.Tip="Saves &quot;Pulled&quot; in Bought For instead of a price. It counts as nothing spent." />

            <Grid ColumnDefinitions="*,8,*">
              <Button x:Name="SaveButton" Grid.Column="0" Classes="flat save" Content="Save"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
              <Button x:Name="RevertButton" Grid.Column="2" Classes="flat" Content="Undo changes"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
            </Grid>

            <TextBlock x:Name="EditorMessage" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0" />
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
  </DockPanel>
</UserControl>
