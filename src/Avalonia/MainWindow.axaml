<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Cardmarket_Price_Updater.MainWindow"
        Title="Cardmarket Price Updater"
        Width="980" Height="500"
        MinWidth="720" MinHeight="380"
        Background="#1E1E1E"
        Icon="/Assets/app-icon.ico">

  <Window.Styles>
    <Style Selector="Button.flat">
      <Setter Property="Background" Value="#3C3C3C" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Padding" Value="10,6" />
    </Style>
    <Style Selector="Button.flat:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#555555" />
    </Style>
    <Style Selector="Button.flat:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="#2D2D2D" />
    </Style>

    <Style Selector="ToggleButton.currency">
      <Setter Property="Background" Value="#3C3C3C" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="28" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ToggleButton.currency:checked /template/ ContentPresenter">
      <Setter Property="Background" Value="#5A5A5A" />
    </Style>
    <Style Selector="ToggleButton.currency:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#4B4B4B" />
    </Style>

    <Style Selector="Button.link">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Button.link:pointerover /template/ ContentPresenter">
      <Setter Property="TextBlock.TextDecorations" Value="Underline" />
    </Style>

    <Style Selector="TextBox /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="#2D2D2D" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="#2D2D2D" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="#2D2D2D" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="TextBox:focus-within /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="#2D2D2D" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
  </Window.Styles>

  <DockPanel>
    <Border DockPanel.Dock="Top" Background="#282828" Padding="12,10">
      <Grid ColumnDefinitions="*,Auto">
        <!-- Wraps onto a second line instead of clipping when the window is narrow -->
        <WrapPanel Grid.Column="0" Orientation="Horizontal">
          <Button x:Name="StartButton" Classes="flat" Content="Get Prices (Browse Files)"
                  Margin="0,0,10,4" VerticalAlignment="Center" />

          <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,10,4" VerticalAlignment="Center">
            <ToggleButton x:Name="CurrencyGbp" Classes="currency" Content="£" IsChecked="True" />
            <ToggleButton x:Name="CurrencyEur" Classes="currency" Content="€" />
            <ToggleButton x:Name="CurrencyUsd" Classes="currency" Content="$" />
          </StackPanel>

          <ComboBox x:Name="PriceTypeCombo" Width="170" Margin="0,0,8,4" VerticalAlignment="Center" />

          <ComboBox x:Name="GameCombo" Width="190" Margin="0,0,10,4" VerticalAlignment="Center"
                    ToolTip.Tip="Game to use when the spreadsheet has no Game column (or a blank Game cell)" />

          <CheckBox x:Name="ImagesCheck" Content="Card images" Foreground="White"
                    Margin="0,0,10,4" VerticalAlignment="Center"
                    ToolTip.Tip="Add card thumbnails to the Image column (only used if the spreadsheet has an Image column and a Set Code column)" />
        </WrapPanel>

        <Button x:Name="CloseButton" Grid.Column="1" Classes="flat" Content="Close"
                VerticalAlignment="Top" Margin="10,0,0,0" />
      </Grid>
    </Border>

    <Border DockPanel.Dock="Bottom" Padding="12,6">
      <Button x:Name="VersionLink" Classes="link" HorizontalAlignment="Left" />
    </Border>

    <Border Padding="12,10,12,0">
      <TextBox x:Name="OutputBox"
               Background="#2D2D2D"
               Foreground="White"
               BorderThickness="0"
               FontFamily="Consolas,Menlo,monospace"
               FontSize="13"
               IsReadOnly="True"
               AcceptsReturn="True"
               TextWrapping="NoWrap"
               VerticalContentAlignment="Top" />
    </Border>
  </DockPanel>
</Window>
